# Environment configuration for radiopharmaceutical-usp-825-agent
# Copy this file to .env and replace with a cryptographically strong random key

# HMAC-SHA256 audit signing key (minimum 16 characters)
AUDIT_SECRET_KEY=change-me-to-a-random-secret-key-min-16-chars

# LLM provider: mock, ollama, claude, openai
MODEL_PROVIDER=mock
